				<batch:step name="ValidRecords" doc:id="ecf5b367-2b04-4964-ae89-fb57c1d096b1" acceptExpression='!isEmpty(payload[0].SKU) and !isEmpty(payload[0].StoreId) and !isEmpty(payload[0]."Type") and !isEmpty(payload[0].Quantity) and !isEmpty(payload[0].Timestamp) and (((payload.Quantity[0] as Number) mod 1) == 0) and (payload[0].Type == "Backorder" or payload[0]."Type" == "Standard")'>
					<batch:aggregator doc:name="batch-aggregator" doc:id="12a9d3a5-5ea9-45b5-831d-d7c6a8c459ac" size="${batch.agg-size}">
						<ee:transform doc:name="Payload to JSON and StoreId Grouping" doc:id="a85665a9-8c58-49df-8a71-b62d598156f6" >
