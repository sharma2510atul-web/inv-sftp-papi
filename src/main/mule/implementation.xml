								<ee:set-payload resource="dwl/msg-payload-mapping.dwl" />
							
</ee:message>
						</ee:transform>
						<foreach doc:name="for-each" doc:id="297c4c5f-86de-44b7-b46d-f01a2e6cc587" collection="#[payload]">
							<ee:transform doc:name="StoreId, FileName and RecordDetails variable" doc:id="4b32ed78-dee7-46ee-ad7d-976b07a78ae7" >
								<ee:message >
								</ee:message>
								<ee:variables >
									<ee:set-variable variableName="storeId" ><![CDATA[%dw 2.0
output application/java
---
payload.StoreId]]></ee:set-variable>
									<ee:set-variable variableName="recordDetails" ><![CDATA[%dw 2.0
output application/java
---
payload.recordDetails]]></ee:set-variable>
									<ee:set-variable resource="dwl/var-fileName-destination.dwl" variableName="fileName" />
								
</ee:variables>
							</ee:transform>
							<try doc:name="try-catch" doc:id="8d191c03-a060-4edf-a034-f6979c777ecc" >
								<sftp:write doc:name="Write files at destination" doc:id="dbb5dc62-0ee6-4964-9fe9-1a1645a0b66b" config-ref="SFTP_Config" path="#[Mule::p('sftp.destination-path') ++ (vars.orgFileName default &quot;&quot;)]" mode="CREATE_NEW">
									<sftp:content ><![CDATA[#[%dw 2.0
output application/csv header=true,separator=","
---
vars.recordDetails]]]></sftp:content>
								</sftp:write>
								<error-handler >
									<on-error-continue enableNotifications="false" logException="false" doc:name="on-error-continue" doc:id="9971c6b6-d786-4246-9ae9-d9a5a9d5f673" type="SFTP:FILE_ALREADY_EXISTS" >
										<sftp:write doc:name="Write files at destination" doc:id="5dc30ce7-f479-4d55-951c-b4ec299fdd1d" config-ref="SFTP_Config" path="#[Mule::p('sftp.destination-path') ++ (vars.orgFileName default &quot;&quot;)]" mode="APPEND">
											<sftp:content ><![CDATA[#[%dw 2.0
output application/csv header=true,separator=","
---
vars.recordDetails]]]></sftp:content>
										</sftp:write>
									
</on-error-continue>
								</error-handler>
							</try>
						</foreach>
					</batch:aggregator>
				</batch:step>
				<batch:step name="OnlyFailures" doc:id="5edcc65b-41b4-47af-a4c7-e441627e1b7f" acceptPolicy="ONLY_FAILURES">
					<batch:aggregator doc:name="batch-aggregator" doc:id="b5c45e9a-6f50-462c-81fe-8c270b29fd29" preserveMimeTypes="true" size="${batch.agg-size}">
						<ee:transform doc:name="Payload to JSON" doc:id="a74928d8-9940-43d9-86ba-0401719873d3">
							<ee:message>
								<ee:set-payload><![CDATA[output application/json indent=false
---
flatten(payload)]]></ee:set-payload>
							</ee:message>
						</ee:transform>
						<logger level="ERROR" doc:name="ERROR:Log Failed Record" doc:id="677ae9cf-56ed-4cb3-b651-d544ced6f4c3" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "ERROR",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": "Mule Processing failed " ++ (vars.orgFileName default ""),&#10;    "payload": payload&#10;}]'/>
						<ee:transform doc:name="emailBody" doc:id="378be445-b244-4ce6-a621-cbb2e57c3f1e">
							<ee:message />
							<ee:variables>
								<ee:set-variable resource="dwl/var-mule-prc-failed-email-message.dwl" variableName="emailMessage" />
							</ee:variables>
						</ee:transform>
						<until-successful maxRetries="#[Mule::p('until-successful.max-retries')]" doc:name="until-successful" doc:id="b33a8152-9477-41cf-8aed-f2928effceb6" millisBetweenRetries="#[Mule::p('until-successful.frequency')]">
							<try doc:name="try-catch" doc:id="97a8f5c1-48e1-4b87-9acc-ac399c91cdd0" >
								<http:request method="POST" doc:name="Email Request" doc:id="4a6c47a3-a49a-4a48-82d5-840266c3eb3c" config-ref="HTTP_SMTP_Request_configuration" path="#[Mule::p('http.request.path')]">
							<http:body><![CDATA[#[output application/json
---
{
  "emailSubject": "Mule Application Error Notification",
  "emailMessage": vars.emailMessage,
  "emailAddress":  Mule::p('email.id')
}]]]></http:body>
							<http:headers><![CDATA[#[output application/json
---
{
	"x-correlation-id": vars.correlationId default uuid(),
	"client_id": Mule::p('secure::http.request.client_id'),
	"client_secret": Mule::p('secure::http.request.client_secret')
}]]]></http:headers>
						</http:request>
								<error-handler >
									<on-error-propagate enableNotifications="true" logException="true" doc:name="on-error-propagate" doc:id="b7dd3110-f00b-4585-90bd-6cb55701d2cc" type="HTTP:CONNECTIVITY, HTTP:TIMEOUT, HTTP:INTERNAL_SERVER_ERROR, HTTP:BAD_GATEWAY, HTTP:SERVICE_UNAVAILABLE">
										<logger level="ERROR" doc:name="ERROR:Log Failed Email Sent will retry" doc:id="5e566a3b-6938-40b3-8aaf-a8c1e1cff80d" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "ERROR",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": "Transient error will retry again",&#10;    "payload": payload&#10;}]'/>
									</on-error-propagate>
									<on-error-continue enableNotifications="true" logException="true" doc:name="on-error-continue" doc:id="24dbc234-e3bf-4de0-9cc3-81aa6675d02b" type="ANY">
											<set-variable value="#[output application/json&#10;---&#10;error]" doc:name="Set errorDetails" doc:id="423846e8-bf5e-4b18-821e-9e5fee0f48d0" variableName="errorDetails"/>
									</on-error-continue>
								</error-handler>
							</try>
						</until-successful>
						<choice doc:name="Choice" doc:id="8ea160d2-42af-4d0a-bb24-7df85589ba33">
								<when expression="#[!isEmpty(vars.errorDetails)]">
									<raise-error doc:name="Raise error SMTP:OTHER_ERROR" doc:id="958dd230-c2f3-4bfc-a1f4-2b43f66f026d" type="SMTP:OTHER_ERROR" />
								</when>
							</choice>
					
</batch:aggregator>
				</batch:step>
			
</batch:process-records>
			<batch:on-complete >
				<sftp:move doc:name="Move to Archive folder" doc:id="3aa4baab-3694-4926-abcc-9171cdf53352" config-ref="SFTP_Config" sourcePath="#[Mule::p('sftp.source-path') ++ (vars.orgFileName default &quot;&quot;)]" targetPath="#[Mule::p('sftp.archive-path')]" renameTo='#["processed_" ++ (now() as String) ++ "_" ++ (vars.orgFileName default "")]'/>
				<set-variable value="#[output application/json&#10;---&#10;[]]" doc:name="failedRecordDetails variable" doc:id="4935884b-d621-45df-880f-e9895c56b221" variableName="failedRecordDetails" />
				<flow-ref doc:name="Flow Reference to consume-failedRecords-flow" doc:id="fb84b81d-282e-4488-8daf-8fc26153f330" name="consume-failedRecords-sub-flow"/>
			</batch:on-complete>
		</batch:job>
		<logger level="INFO" doc:name="Log End INFO" doc:id="089f3efd-580e-465c-9538-c0c20b76448e" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "INFO",&#10;    "flowName": "inventory-papi-batch-job-sub-flow",&#10;    "step": "END",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": "Segregation of valid and invalid records in the file " ++ (vars.orgFileName default "") ++ " completed"&#10;}]' />
		<logger level="DEBUG" doc:name="Log End DEBUG" doc:id="377910bc-bfca-4f59-8c6d-86f926e2ce54" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "DEBUG",&#10;    "flowName": "inventory-papi-batch-job-sub-flow",&#10;    "step": "END",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": "Segregation of valid and invalid records in the file " ++ (vars.orgFileName default "") ++ " ended",&#10;    "payload": write(vars.filePayload, "application/json")&#10;}]' category="${debug.category}" />
	
</sub-flow>
	
</mule>
