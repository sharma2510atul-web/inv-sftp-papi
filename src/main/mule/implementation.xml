				<batch:step name="TypeNotOfStandardOrBackOrder" doc:id="e484034d-8f3d-45f5-b791-34da50be701d" acceptExpression='!(["Backorder","Standard"] contains payload[0]."Type")' acceptPolicy="ALL">
					<batch:aggregator doc:name="batch-aggregator" doc:id="432bb3e2-6ff9-4c6b-b954-c00b26adaa9d" preserveMimeTypes="true" size="${batch.agg-size}">
						<ee:transform doc:name="Payload to JSON" doc:id="dce43ad4-bbe2-4e2e-a736-147b4e1d7438">
							<ee:message>
								<ee:set-payload><![CDATA[output application/json indent=false
---
flatten(payload)]]></ee:set-payload>
							</ee:message>
							<ee:variables>
								<ee:set-variable variableName="errorMsg"><![CDATA[%dw 2.0
output application/json
---
"Type not a standard or backorder "]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
						<flow-ref doc:name="Flow Reference to publish-failed-records-sub-flow" doc:id="96fa5a0f-529c-4a59-bd7a-27071791d0a2" name="publish-failed-records-sub-flow" />
					
</batch:aggregator>
				</batch:step>
				<batch:step name="ValidRecords" doc:id="c2fb615d-2ca3-46b2-b4f5-dab2d7e2dcc6" acceptExpression='!isEmpty(payload.SKU[0]) and !isEmpty(payload.StoreId[0]) and !isEmpty(payload."Type"[0]) and !isEmpty(payload.Quantity[0]) and !isEmpty(payload.Timestamp[0]) and (if(!isEmpty(payload[0].Quantity)) (((payload[0].Quantity as Number) mod 1)  == 0) else false) and (["Backorder","Standard"] contains payload."Type"[0])' acceptPolicy="ALL">
					<batch:aggregator doc:name="batch-aggregator" doc:id="96da9d22-cc5c-4b99-af01-ce68001f6944" size="${batch.agg-size}" preserveMimeTypes="true">
						<flow-ref doc:name="Flow Reference to valid-records-processing-sub-flow" doc:id="9ae400bd-f59a-4c51-894a-7db48202c5f6" name="valid-records-processing-sub-flow" />
					</batch:aggregator>
				</batch:step>
				<batch:step name="OnlyFailures" doc:id="74f8e4fc-6f7b-48bf-aa8e-4a2997c8a413" acceptPolicy="ONLY_FAILURES">
					<batch:aggregator doc:name="batch-aggregator" doc:id="6392d2b3-8a51-4101-940e-f91f77d85547" preserveMimeTypes="true" size="${batch.agg-size}">
						<ee:transform doc:name="Payload to JSON" doc:id="974e3bd0-54b9-4250-93ec-e221163b7b39">
							<ee:message>
								<ee:set-payload><![CDATA[output application/json indent=false
---
flatten(payload)]]></ee:set-payload>
							</ee:message>
						</ee:transform>
						<logger level="ERROR" doc:name="ERROR:Log Failed Record" doc:id="2a17c384-7029-432e-85a9-c5a584ab8779" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "ERROR",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": "Mule Processing failed " ++ (vars.orgFileName default ""),&#10;    "payload": payload&#10;}]'/>
						<ee:transform doc:name="emailBody" doc:id="0aab300e-c530-4896-af92-0a821d6981a4">
							<ee:message />
							<ee:variables>
								<ee:set-variable resource="dwl/var-mule-prc-failed-email-message.dwl" variableName="emailMessage" />
							</ee:variables>
						</ee:transform>
						<flow-ref doc:name="Flow Reference to smtp-request-sub-flow" doc:id="c1e24a5a-d47c-4c02-86b4-be52b25e2d39" name="smtp-request-sub-flow" />
					
</batch:aggregator>
				</batch:step>
			
</batch:process-records>
			<batch:on-complete >
				<sftp:move doc:name="Move to Archive folder" doc:id="7caf8c34-1fed-4762-8d43-f5fd5e199193" config-ref="SFTP_Config" sourcePath="#[Mule::p('sftp.source-path') ++ (vars.orgFileName default &quot;&quot;)]" targetPath="#[Mule::p('sftp.archive-path')]" renameTo='#["processed_" ++ (now() as String) ++ "_" ++ (vars.orgFileName default "")]'/>
				<set-variable value="#[output application/json&#10;---&#10;[]]" doc:name="failedRecordDetails variable" doc:id="4d3af48d-4cae-4d8d-9b04-f80d83ba01d2" variableName="failedRecordDetails" />
				<flow-ref doc:name="Flow Reference to consume-failedRecords-flow" doc:id="4f33f157-1711-408d-a016-976ff5459b30" name="consume-failedRecords-sub-flow"/>
			</batch:on-complete>
		</batch:job>
	
</sub-flow>
	</mule>
