								<ee:set-payload><![CDATA[output application/json indent=false
---
flatten(payload)]]></ee:set-payload>
							</ee:message>
							<ee:variables >
								<ee:set-variable variableName="errorMsg" ><![CDATA[%dw 2.0
output application/json
---
"Missing SKU details"]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
						<flow-ref doc:name="Flow Reference to publish-failed-records-sub-flow" doc:id="6dd61c66-f29d-4536-9d07-d8a7bf92df0f" name="publish-failed-records-sub-flow" />
					
</batch:aggregator>
				</batch:step>
				<batch:step name="StoreIdNotPresent" doc:id="b38d9c5f-1522-4f1c-bbda-b0e940a257ab" acceptExpression="isEmpty(payload[0].StoreId)" acceptPolicy="ALL">
