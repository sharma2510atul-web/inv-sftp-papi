	<sub-flow name="valid-records-processing-sub-flow" doc:id="8465bfe6-23b7-4150-bf06-5b9647510460" >
		<logger level="DEBUG" doc:name="Log Valid Record Processing Started" doc:id="1f92b5fa-ce3b-4e3c-b6be-6a388ac6a04e" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "DEBUG",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": "Valid Record Processing Started " ++ (vars.orgFileName default ""),&#10;    "payload": payload&#10;}]' category="${debug.category}" />
		<ee:transform doc:name="Payload to JSON and StoreId Grouping" doc:id="d9a1a064-69f1-4844-8264-429e89abc5a2">
							<ee:message>
								<ee:set-payload resource="dwl/msg-payload-mapping.dwl" />
							</ee:message>
						</ee:transform>
		<foreach doc:name="for-each" doc:id="c03ddac1-1f6a-454f-81c5-6dfa0c0f9fc9" collection="#[payload]">
							<ee:transform doc:name="StoreId, FileName and RecordDetails variable" doc:id="ba4237ce-ccea-4ff9-b7f4-71dade4a22c1">
								<ee:message />
								<ee:variables>
									<ee:set-variable variableName="recordDetails"><![CDATA[%dw 2.0
output application/java
---
payload.recordDetails]]></ee:set-variable>
									<ee:set-variable resource="dwl/var-fileName-destination.dwl" variableName="fileName" />
								</ee:variables>
							</ee:transform>
							<try doc:name="try-catch" doc:id="5a36025d-b144-4352-b5f7-ee2d6f3ff512">
								<sftp:write doc:name="Write files at destination" doc:id="bbbb838f-43c6-4d46-b6f7-cc6146dd2e2a" config-ref="SFTP_Config" path="#[Mule::p('sftp.destination-path') ++ (vars.fileName default &quot;&quot;)]" mode="CREATE_NEW">
									<sftp:content><![CDATA[#[%dw 2.0
output application/csv header=true,separator=","
---
vars.recordDetails]]]></sftp:content>
								</sftp:write>
								<error-handler>
									<on-error-continue enableNotifications="false" logException="false" doc:name="on-error-continue" doc:id="2f589b02-c09e-4c3d-852b-b00562416c08" type="SFTP:FILE_ALREADY_EXISTS">
										<sftp:write doc:name="Write files at destination" doc:id="80435b47-d506-4766-a63f-cc16fa1314f8" config-ref="SFTP_Config" path="#[Mule::p('sftp.destination-path') ++ (vars.fileName default &quot;&quot;)]" mode="APPEND">
											<sftp:content><![CDATA[#[%dw 2.0
output application/csv header=true,separator=","
---
vars.recordDetails]]]></sftp:content>
										</sftp:write>
									</on-error-continue>
								</error-handler>
							</try>
						</foreach>
		<logger level="DEBUG" doc:name="Log Valid Record Processing Ended" doc:id="38f2f72e-9468-43f0-aebd-6d61a2717421" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "DEBUG",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": "Valid Record Processing Ended " ++ (vars.orgFileName default ""),&#10;    "payload": payload&#10;}]' category="${debug.category}" />
	</sub-flow>
	<sub-flow name="publish-failed-records-sub-flow" doc:id="8d168e5f-0e09-449a-870e-68237a8202d7" >
		<logger level="ERROR" doc:name="ERROR:Log Failed Record" doc:id="b1c2664d-a17d-47c7-a78c-2a02edf73685" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "ERROR",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": (vars.errorMsg default "") ++ " " ++ (vars.orgFileName default ""),&#10;    "payload": payload&#10;}]' />
		<vm:publish queueName="InvalidRecordQueue" doc:name="Publish failed Records" doc:id="34f4891a-5a4a-4310-88ae-ff3f9261e8c7" config-ref="VM_Config" sendCorrelationId="ALWAYS" correlationId="#[vars.correlationId default uuid()]">
							<vm:content><![CDATA[#[output application/json
---
{
	"failedPayload": payload,
	"message": vars.errorMsg
}]]]></vm:content>
						</vm:publish>
	</sub-flow>
	<sub-flow name="smtp-request-sub-flow" doc:id="73ee3b3f-eb83-4e9b-a708-2f2645e3d9ef" >
		<until-successful maxRetries="#[Mule::p('until-successful.max-retries')]" doc:name="until-successful" doc:id="21e5c1d0-9ad1-4306-9141-d4a5fafddeb7" millisBetweenRetries="#[Mule::p('until-successful.frequency')]">
				<try doc:name="try-catch" doc:id="d0e9390d-597b-4bfe-952f-daaaa518b599">
					<http:request method="POST" doc:name="Email Request" doc:id="8deb9151-5f71-4cdf-b2b6-99ea26f26167" config-ref="HTTP_SMTP_Request_configuration" path="#[Mule::p('http.request.path')]">
						<http:body><![CDATA[#[output application/json
---
{
  "emailSubject": "Mule Application Error Notification",
  "emailMessage": vars.emailMessage,
  "emailAddress": Mule::p('email.id')
}]]]></http:body>
						<http:headers><![CDATA[#[output application/json
---
{
	"x-correlation-id": vars.correlationId default uuid(),
	"client_id": Mule::p('secure::http.request.client_id'),
	"client_secret": Mule::p('secure::http.request.client_secret')
}]]]></http:headers>
					</http:request>
					<error-handler>
						<on-error-propagate enableNotifications="true" logException="true" doc:name="on-error-propagate" doc:id="20d29115-d594-4fba-9036-6a966770ab8c" type="HTTP:CONNECTIVITY, HTTP:TIMEOUT, HTTP:INTERNAL_SERVER_ERROR, HTTP:BAD_GATEWAY, HTTP:SERVICE_UNAVAILABLE">
							<logger level="ERROR" doc:name="ERROR:Log Failed Email Sent will retry" doc:id="df82b09f-3c3c-4734-8c6f-d64abe03dcd3" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "ERROR",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": "Transient error will retry again",&#10;    "payload": payload&#10;}]' />
						</on-error-propagate>
						<on-error-continue enableNotifications="true" logException="true" doc:name="on-error-continue" doc:id="289716bf-5861-4d65-aeb3-52c17a08275f" type="ANY">
											<set-variable value="#[output application/json&#10;---&#10;error]" doc:name="Set errorDetails" doc:id="b61055ec-74a8-4b7f-bc61-42474910f9a5" variableName="errorDetails" />
						</on-error-continue>
					</error-handler>
				</try>
			</until-successful>
		<choice doc:name="Choice" doc:id="ff3d5b0c-b834-4244-a611-24aa59e8d944">
					<when expression="#[!isEmpty(vars.errorDetails)]">
						<raise-error doc:name="Raise error SMTP:OTHER_ERROR" doc:id="20d8b237-327a-45df-a0e9-0c6590117a47" type="SMTP:OTHER_ERROR" />
					</when>
				</choice>
	</sub-flow>
	<sub-flow name="consume-failedRecords-sub-flow" doc:id="ece7ae53-cfe5-4a2b-bf15-aa8e8a209a82" >
		<try doc:name="try-catch" doc:id="a6f213f7-3289-475e-9c86-84ec8b75967e" >
			<vm:consume doc:name="Consume message from Invalid Record Queue" doc:id="ad6eb00a-b405-47ab-aeb4-756a6c5b754e" config-ref="VM_Config" queueName="InvalidRecordQueue"/>
			<ee:transform doc:name="Concat Error Details" doc:id="11335a33-139f-44f2-9bae-17d999f24658" >
				<ee:message >
				</ee:message>
				<ee:variables >
					<ee:set-variable resource="dwl/var-failedRecords-adding.dwl" variableName="failedRecordDetails" />
				
</ee:variables>
			</ee:transform>
			<flow-ref doc:name="Flow Reference to consume-failedRecords-flow" doc:id="b7e964a7-ea05-420e-af7b-06fb6690802c" name="consume-failedRecords-sub-flow"/>
			<error-handler >
				<on-error-continue enableNotifications="true" logException="true" doc:name="on-error-continue" doc:id="b8d78e05-be93-41b6-8bba-c2ca5bbb0059" type="VM:EMPTY_QUEUE">
					<logger level="INFO" doc:name="Log all the failed records are consumed" doc:id="a15e10ee-d1a8-47f7-9f14-9c0f522833e7" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "INFO",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": "All the failed records are consumed or no failed records"&#10;}]'/>
					<choice doc:name="Check if there are any failed records" doc:id="f92891ee-fbf7-46d8-ad33-9402ee511d17" >
						<when expression="#[!isEmpty(vars.failedRecordDetails)]">
							<ee:transform doc:name="emailBody" doc:id="7bc5d282-5f9b-4ed1-9c14-69ec524676cd">
						<ee:message />
						<ee:variables>
									<ee:set-variable resource="dwl/var-invalid-records-email-message.dwl" variableName="emailMessage" />
						</ee:variables>
					</ee:transform>
							<flow-ref doc:name="Flow Reference to smtp-request-sub-flow" doc:id="f31013a4-b8bc-410d-b725-4fa03985e264" name="smtp-request-sub-flow" />
						</when>
						<otherwise >
							<logger level="INFO" doc:name="Log no failed records" doc:id="c1828dcf-50b8-4af2-99f2-f87a8ed5f5b5" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "INFO",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": "No failed records present to be sent for notification"&#10;}]' />
						</otherwise>
					</choice>
				
</on-error-continue>
			</error-handler>
		</try>
	</sub-flow>
	<sub-flow name="inventory-papi-batch-job-sub-flow" doc:id="246b703f-01e6-4ab2-9d16-8fd5013b6917" >
		<logger level="INFO" doc:name="Log Start INFO" doc:id="0baf5f26-4644-43db-8c01-f9b05743623c" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "INFO",&#10;    "flowName": "inventory-papi-batch-job-sub-flow",&#10;    "step": "START",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": "Segregation of valid and invalid records in the file " ++ (vars.orgFileName default "")&#10;}]' />
		<logger level="DEBUG" doc:name="Log Start DEBUG" doc:id="92c264e0-c055-4bd3-ba28-dc4d50ad2d60" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "DEBUG",&#10;    "flowName": "inventory-papi-batch-job-sub-flow",&#10;    "step": "START",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": "Segregation of valid and invalid records in the file " ++ (vars.orgFileName default ""),&#10;    "payload": payload&#10;}]' category="${debug.category}" />
		<batch:job jobName="inventory-papi-batch-job" doc:id="213c9d97-3d56-4d89-81fe-81adc624d2d5" blockSize="${batch.block-size}" maxFailedRecords="-1">
			<batch:process-records >
				<batch:step name="SKUNotPresent" doc:id="417713dc-28e4-4d4d-83f9-192b441ff317" acceptExpression="isEmpty(payload[0].SKU)" acceptPolicy="ALL">
					<batch:aggregator doc:name="batch-aggregator" doc:id="8d4b93d5-5bf1-4a71-b8fc-ba159b2692af" preserveMimeTypes="true" size="${batch.agg-size}">
