					<batch:aggregator doc:name="batch-aggregator" doc:id="5b9e0aab-d7ac-4977-9539-77690be685ca" preserveMimeTypes="true" size="${batch.agg-size}">
						<ee:transform doc:name="Payload to JSON" doc:id="5e889ece-d21c-4a0e-b3ba-43a208e1d34d">
							<ee:message>
								<ee:set-payload><![CDATA[output application/json indent=false
---
flatten(payload)]]></ee:set-payload>
							</ee:message>
							<ee:variables>
								<ee:set-variable variableName="errorMsg"><![CDATA[%dw 2.0
output application/json
---
"Missing Timestamps details"]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
						<flow-ref doc:name="Flow Reference to publish-failed-records-sub-flow" doc:id="5a755ff8-ea60-40f1-854f-5c99ebae4929" name="publish-failed-records-sub-flow" />
					
</batch:aggregator>
				</batch:step>
				<batch:step name="QuantityNotWholeNumber" doc:id="0cc76bf3-6bce-423a-b471-1af24bd6fda5" acceptExpression="(if(!isEmpty(payload[0].Quantity)) (((payload[0].Quantity as Number) mod 1)  != 0) else false) " acceptPolicy="ALL">
					<batch:aggregator doc:name="batch-aggregator" doc:id="6f013c36-aeb0-4838-ae7e-a29105d00019" preserveMimeTypes="true" size="${batch.agg-size}">
						<ee:transform doc:name="Payload to JSON" doc:id="c023eb7c-1bf8-482a-b3e8-5850d73a183c">
							<ee:message>
								<ee:set-payload><![CDATA[output application/json indent=false
---
