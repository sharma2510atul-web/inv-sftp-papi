						<ee:transform doc:name="Payload to JSON" doc:id="afff2e7c-a39f-4738-945b-a1b7e4c92ecc">
							<ee:message>
								<ee:set-payload><![CDATA[output application/json indent=false
---
flatten(payload)]]></ee:set-payload>
							</ee:message>
							<ee:variables>
								<ee:set-variable variableName="errorMsg"><![CDATA[%dw 2.0
output application/json
---
"Missing Quantity details"]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
						<flow-ref doc:name="Flow Reference to publish-failed-records-sub-flow" doc:id="ad2a25ed-ba96-40ac-9c85-af97065833b3" name="publish-failed-records-sub-flow" />
					
</batch:aggregator>
