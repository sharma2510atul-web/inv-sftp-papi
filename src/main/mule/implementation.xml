	<sub-flow name="consume-failedRecords-sub-flow" doc:id="ece7ae53-cfe5-4a2b-bf15-aa8e8a209a82" >
		<try doc:name="try-catch" doc:id="a6f213f7-3289-475e-9c86-84ec8b75967e" >
			<vm:consume doc:name="Consume message from Invalid Record Queue" doc:id="ad6eb00a-b405-47ab-aeb4-756a6c5b754e" config-ref="VM_Config" queueName="InvalidRecordQueue"/>
			<ee:transform doc:name="Concat Error Details" doc:id="11335a33-139f-44f2-9bae-17d999f24658" >
				<ee:message >
				</ee:message>
				<ee:variables >
					<ee:set-variable resource="dwl/var-failedRecords-adding.dwl" variableName="failedRecordDetails" />
				
</ee:variables>
			</ee:transform>
			<flow-ref doc:name="Flow Reference to consume-failedRecords-flow" doc:id="b7e964a7-ea05-420e-af7b-06fb6690802c" name="consume-failedRecords-sub-flow"/>
			<error-handler >
				<on-error-continue enableNotifications="true" logException="true" doc:name="on-error-continue" doc:id="b8d78e05-be93-41b6-8bba-c2ca5bbb0059" type="VM:EMPTY_QUEUE">
					<logger level="INFO" doc:name="Log all the failed records are consumed" doc:id="a15e10ee-d1a8-47f7-9f14-9c0f522833e7" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "INFO",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": "All the failed records are consumed or no failed records"&#10;}]'/>
					<choice doc:name="Check if there are any failed records" doc:id="f92891ee-fbf7-46d8-ad33-9402ee511d17" >
						<when expression="#[!isEmpty(vars.failedRecordDetails)]">
							<ee:transform doc:name="emailBody" doc:id="7bc5d282-5f9b-4ed1-9c14-69ec524676cd">
						<ee:message />
						<ee:variables>
									<ee:set-variable resource="dwl/var-invalid-records-email-message.dwl" variableName="emailMessage" />
						</ee:variables>
					</ee:transform>
							<until-successful maxRetries="#[Mule::p('until-successful.max-retries')]" doc:name="until-successful" doc:id="8714b62d-6a2b-400d-8573-694de2671269" millisBetweenRetries="#[Mule::p('until-successful.frequency')]">
								<try doc:name="try-catch" doc:id="8f3f23aa-e86e-44b7-a1b8-9ecbd0a0ece7" >
									<http:request method="POST" doc:name="Email Request" doc:id="b1691b74-8f82-43c3-9272-dfdb395d9759" config-ref="HTTP_SMTP_Request_configuration" path="#[Mule::p('http.request.path')]" >
										<http:body ><![CDATA[#[output application/json
---
{
  "emailSubject": "Mule Application Error Notification",
  "emailMessage": vars.emailMessage,
  "emailAddress":  Mule::p('email.id')
}]]]></http:body>
										<http:headers ><![CDATA[#[output application/json
---
{
	"x-correlation-id": vars.correlationId default uuid(),
	"client_id": Mule::p('secure::http.request.client_id'),
	"client_secret": Mule::p('secure::http.request.client_secret')
}]]]></http:headers>
									</http:request>
									<error-handler >
										<on-error-propagate enableNotifications="true" logException="true" doc:name="on-error-propagate" doc:id="82d47c25-2ab6-4978-b1b6-59bf39516fe5" type="HTTP:CONNECTIVITY, HTTP:TIMEOUT, HTTP:INTERNAL_SERVER_ERROR, HTTP:BAD_GATEWAY, HTTP:SERVICE_UNAVAILABLE" >
											<logger level="ERROR" doc:name="ERROR:Log Failed Email Sent will retry" doc:id="f73a07ca-a26e-4b65-abbb-cc32ccd3e3bc" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "ERROR",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": "Transient error will retry again",&#10;    "payload": payload&#10;}]' />
										</on-error-propagate>
										<on-error-continue enableNotifications="true" logException="true" doc:name="on-error-continue" doc:id="f5b805d7-fd6e-4b33-ab52-03b33de5540f" type="ANY">
											<set-variable value="#[output application/json&#10;---&#10;error]" doc:name="Set errorDetails" doc:id="54339583-653f-4c0a-9236-a3727e93dd94" variableName="errorDetails"/>
										</on-error-continue>
									</error-handler>
								</try>
							</until-successful>
							<choice doc:name="Choice" doc:id="99d7c1ea-fbd8-48e6-a248-643247a4ad5c" >
								<when expression="#[!isEmpty(vars.errorDetails)]">
									<raise-error doc:name="Raise error SMTP:OTHER_ERROR" doc:id="51d42208-dfbf-425e-abb5-5c034ac86d1e" type="SMTP:OTHER_ERROR"/>
								</when>
							</choice>
						</when>
						<otherwise >
							<logger level="INFO" doc:name="Log no failed records" doc:id="c1828dcf-50b8-4af2-99f2-f87a8ed5f5b5" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "INFO",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": "No failed records present to be sent for notification"&#10;}]' />
						</otherwise>
					</choice>
				
</on-error-continue>
			</error-handler>
		</try>
	</sub-flow>
