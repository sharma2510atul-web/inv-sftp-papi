						<vm:publish queueName="InvalidRecordQueue" doc:name="Publish failed Records" doc:id="90a6f969-3959-4b78-ad99-32b70b57585b" config-ref="VM_Config" sendCorrelationId="ALWAYS" correlationId="#[vars.correlationId default uuid()]">
