	<sub-flow name="consume-failedRecords-sub-flow" doc:id="465f4401-f079-46b0-b937-112d7e87378d" >
		<try doc:name="try-catch" doc:id="861f7040-b52a-4bd7-9233-995fa54b211c" >
			<vm:consume doc:name="Consume message from Invalid Record Queue" doc:id="be819c53-8c5b-4280-852d-d3322ebbe0c2" config-ref="VM_Config" queueName="InvalidRecordQueue"/>
			<ee:transform doc:name="Concat Error Details" doc:id="fb48410c-be0f-41b9-81fa-ab5d917f8519" >
				<ee:message >
				</ee:message>
				<ee:variables >
					<ee:set-variable resource="dwl/var-failedRecords-adding.dwl" variableName="failedRecordDetails" />
				
</ee:variables>
			</ee:transform>
			<flow-ref doc:name="Flow Reference to consume-failedRecords-flow" doc:id="f25eeebe-6977-451c-9c6c-d8875a1d3c3b" name="consume-failedRecords-sub-flow"/>
			<error-handler >
				<on-error-continue enableNotifications="true" logException="true" doc:name="on-error-continue" doc:id="ed1f62a0-df15-47cc-a531-673e9a9e5335" type="VM:EMPTY_QUEUE">
					<logger level="INFO" doc:name="Log all the failed records are consumed" doc:id="a918073c-310c-4272-8d6d-f08069909e46" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "INFO",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": "All the failed records are consumed or no failed records"&#10;}]'/>
					<choice doc:name="Check if there are any failed records" doc:id="a1c35310-ba5b-41dc-a147-a4a3feb735be" >
						<when expression="#[!isEmpty(vars.failedRecordDetails)]">
							<ee:transform doc:name="emailBody" doc:id="7f4a6cba-c67d-4f72-9004-c35fc9043c0e">
						<ee:message />
						<ee:variables>
									<ee:set-variable resource="dwl/var-invalid-records-email-message.dwl" variableName="emailMessage" />
						</ee:variables>
					</ee:transform>
							<until-successful maxRetries="#[Mule::p('until-successful.max-retries')]" doc:name="until-successful" doc:id="e0b2f21b-8905-44c8-af99-a737baa52a74" millisBetweenRetries="#[Mule::p('until-successful.frequency')]">
								<try doc:name="try-catch" doc:id="e8724e87-88cd-42cf-b703-4c23234e28fa" >
									<http:request method="POST" doc:name="Email Request" doc:id="8510af26-1ecb-4f8d-a0a8-7eb1240a1392" config-ref="HTTP_SMTP_Request_configuration" path="#[Mule::p('http.request.path')]" >
										<http:body ><![CDATA[#[output application/json
---
{
  "emailSubject": "Mule Application Error Notification",
  "emailMessage": vars.emailMessage,
  "emailAddress":  Mule::p('email.id')
}]]]></http:body>
										<http:headers ><![CDATA[#[output application/json
---
{
	"x-correlation-id": vars.correlationId default uuid(),
	"client_id": Mule::p('secure::http.request.client_id'),
	"client_secret": Mule::p('secure::http.request.client_secret')
}]]]></http:headers>
									</http:request>
									<error-handler >
										<on-error-propagate enableNotifications="true" logException="true" doc:name="on-error-propagate" doc:id="0e52a2e9-18cb-458a-9ef4-8c2582f5ecb4" type="HTTP:CONNECTIVITY, HTTP:TIMEOUT, HTTP:INTERNAL_SERVER_ERROR, HTTP:BAD_GATEWAY, HTTP:SERVICE_UNAVAILABLE" >
											<logger level="ERROR" doc:name="ERROR:Log Failed Email Sent will retry" doc:id="d7666def-d9fa-47de-be59-3999f4906743" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "ERROR",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": "Transient error will retry again",&#10;    "payload": payload&#10;}]' />
										</on-error-propagate>
										<on-error-continue enableNotifications="true" logException="true" doc:name="on-error-continue" doc:id="b33b3a45-e08c-4447-8d15-38e28fafe24b" type="ANY">
											<set-variable value="#[output application/json&#10;---&#10;error]" doc:name="Set errorDetails" doc:id="41bd1ec6-f1de-4fbb-877e-c451ac028eb9" variableName="errorDetails"/>
										</on-error-continue>
									</error-handler>
								</try>
							</until-successful>
							<choice doc:name="Choice" doc:id="d44a0596-ef15-4b8f-b8a0-13cb9479ae1a" >
								<when expression="#[!isEmpty(vars.errorDetails)]">
									<raise-error doc:name="Raise error SMTP:OTHER_ERROR" doc:id="b6024e6c-14c9-47de-9507-e7ac0e34db25" type="SMTP:OTHER_ERROR"/>
								</when>
							</choice>
						</when>
						<otherwise >
							<logger level="INFO" doc:name="Log no failed records" doc:id="9346ac8b-15bf-4237-aa97-00c738432d76" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "INFO",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": "No failed records present to be sent for notification"&#10;}]' />
						</otherwise>
					</choice>
				
</on-error-continue>
			</error-handler>
		</try>
	</sub-flow>
