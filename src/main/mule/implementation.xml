						<ee:transform doc:name="Payload to JSON" doc:id="3479bfeb-a0b0-4b0d-bafb-d5b773bde9b0">
							<ee:message>
								<ee:set-payload><![CDATA[output application/json indent=false
---
flatten(payload)]]></ee:set-payload>
							</ee:message>
							<ee:variables>
								<ee:set-variable variableName="errorMsg"><![CDATA[%dw 2.0
output application/json
---
"Missing StoreId details"]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
						<flow-ref doc:name="Flow Reference to publish-failed-records-sub-flow" doc:id="7460f7fd-baff-470e-a235-a42b5d8e4d5d" name="publish-failed-records-sub-flow" />
					
</batch:aggregator>
				</batch:step>
				<batch:step name="TypeNotPresent" doc:id="0510ae3e-7eef-4794-ae89-f27d4ee948ad" acceptExpression='isEmpty(payload[0]."Type")' acceptPolicy="ALL">
					<batch:aggregator doc:name="batch-aggregator" doc:id="b308913d-292d-4bec-b715-c0411c07e51f" preserveMimeTypes="true" size="${batch.agg-size}">
						<ee:transform doc:name="Payload to JSON" doc:id="68438918-bc72-4242-8cff-a8d02e9dcb79">
							<ee:message>
								<ee:set-payload><![CDATA[output application/json indent=false
---
flatten(payload)]]></ee:set-payload>
							</ee:message>
							<ee:variables>
								<ee:set-variable variableName="errorMsg"><![CDATA[%dw 2.0
output application/json
---
"Missing Type details"]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
						<flow-ref doc:name="Flow Reference to publish-failed-records-sub-flow" doc:id="0ef4e6f4-6799-4a49-b33a-81a06f2c3ad1" name="publish-failed-records-sub-flow" />
					
</batch:aggregator>
				</batch:step>
				<batch:step name="QuantityNotPresent" doc:id="8d377b13-4f14-4359-a75a-1b23dff559ef" acceptExpression="if(!isEmpty(payload[0].Quantity)) ((payload[0].Quantity as Number) mod 1)  != 0 else false" acceptPolicy="ALL">
