								<error-handler >
									<on-error-continue enableNotifications="false" logException="false" doc:name="on-error-continue" doc:id="c3e0f158-675f-4988-8d0c-dfff839a0fab" type="SFTP:FILE_ALREADY_EXISTS" >
										<sftp:write doc:name="Write files at destination" doc:id="b3cbeea7-3d0b-4823-9568-7030e6efbeb2" config-ref="SFTP_Config" path="#[Mule::p('sftp.destination-path') ++ (vars.orgFileName default &quot;&quot;)]" mode="APPEND">
											<sftp:content ><![CDATA[#[%dw 2.0
output application/csv header=true,separator=","
---
vars.recordDetails]]]></sftp:content>
										</sftp:write>
									
</on-error-continue>
								</error-handler>
							</try>
						</foreach>
					</batch:aggregator>
				</batch:step>
				<batch:step name="OnlyFailures" doc:id="74f8e4fc-6f7b-48bf-aa8e-4a2997c8a413" acceptPolicy="ONLY_FAILURES">
					<batch:aggregator doc:name="batch-aggregator" doc:id="6392d2b3-8a51-4101-940e-f91f77d85547" preserveMimeTypes="true" size="${batch.agg-size}">
						<ee:transform doc:name="Payload to JSON" doc:id="974e3bd0-54b9-4250-93ec-e221163b7b39">
							<ee:message>
								<ee:set-payload><![CDATA[output application/json indent=false
---
flatten(payload)]]></ee:set-payload>
							</ee:message>
						</ee:transform>
						<logger level="ERROR" doc:name="ERROR:Log Failed Record" doc:id="2a17c384-7029-432e-85a9-c5a584ab8779" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "ERROR",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": "Mule Processing failed " ++ (vars.orgFileName default ""),&#10;    "payload": payload&#10;}]'/>
						<ee:transform doc:name="emailBody" doc:id="0aab300e-c530-4896-af92-0a821d6981a4">
							<ee:message />
							<ee:variables>
								<ee:set-variable resource="dwl/var-mule-prc-failed-email-message.dwl" variableName="emailMessage" />
							</ee:variables>
						</ee:transform>
						<until-successful maxRetries="#[Mule::p('until-successful.max-retries')]" doc:name="until-successful" doc:id="1be357ae-89d9-4d00-a3ef-45d21735db79" millisBetweenRetries="#[Mule::p('until-successful.frequency')]">
							<try doc:name="try-catch" doc:id="7185d897-6488-4701-bc05-f1f9c5ebd45d" >
								<http:request method="POST" doc:name="Email Request" doc:id="c66214e1-0b54-4800-8504-1d87059cf46f" config-ref="HTTP_SMTP_Request_configuration" path="#[Mule::p('http.request.path')]">
							<http:body><![CDATA[#[output application/json
---
{
  "emailSubject": "Mule Application Error Notification",
  "emailMessage": vars.emailMessage,
  "emailAddress":  Mule::p('email.id')
}]]]></http:body>
							<http:headers><![CDATA[#[output application/json
---
{
	"x-correlation-id": vars.correlationId default uuid(),
	"client_id": Mule::p('secure::http.request.client_id'),
	"client_secret": Mule::p('secure::http.request.client_secret')
}]]]></http:headers>
						</http:request>
								<error-handler >
									<on-error-propagate enableNotifications="true" logException="true" doc:name="on-error-propagate" doc:id="3ac70f62-1c16-47b5-b284-60861b0930d9" type="HTTP:CONNECTIVITY, HTTP:TIMEOUT, HTTP:INTERNAL_SERVER_ERROR, HTTP:BAD_GATEWAY, HTTP:SERVICE_UNAVAILABLE">
										<logger level="ERROR" doc:name="ERROR:Log Failed Email Sent will retry" doc:id="00a80f75-5c3e-49c1-8b33-966fb8e72b39" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "ERROR",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": "Transient error will retry again",&#10;    "payload": payload&#10;}]'/>
									</on-error-propagate>
									<on-error-continue enableNotifications="true" logException="true" doc:name="on-error-continue" doc:id="e776f280-93cc-49f0-90df-b9f1a2a764d5" type="ANY">
											<set-variable value="#[output application/json&#10;---&#10;error]" doc:name="Set errorDetails" doc:id="6536bcc0-06a0-4bcf-b97d-02416f0c2b1c" variableName="errorDetails"/>
									</on-error-continue>
								</error-handler>
							</try>
						</until-successful>
						<choice doc:name="Choice" doc:id="b87a11e2-278b-4bd0-b60d-07e5dd2445b9">
								<when expression="#[!isEmpty(vars.errorDetails)]">
									<raise-error doc:name="Raise error SMTP:OTHER_ERROR" doc:id="8324cb96-8dd4-4944-93fc-9b0126e52907" type="SMTP:OTHER_ERROR" />
								</when>
							</choice>
					
</batch:aggregator>
				</batch:step>
			
</batch:process-records>
			<batch:on-complete >
				<sftp:move doc:name="Move to Archive folder" doc:id="7caf8c34-1fed-4762-8d43-f5fd5e199193" config-ref="SFTP_Config" sourcePath="#[Mule::p('sftp.source-path') ++ (vars.orgFileName default &quot;&quot;)]" targetPath="#[Mule::p('sftp.archive-path')]" renameTo='#["processed_" ++ (now() as String) ++ "_" ++ (vars.orgFileName default "")]'/>
				<set-variable value="#[output application/json&#10;---&#10;[]]" doc:name="failedRecordDetails variable" doc:id="4d3af48d-4cae-4d8d-9b04-f80d83ba01d2" variableName="failedRecordDetails" />
				<flow-ref doc:name="Flow Reference to consume-failedRecords-flow" doc:id="4f33f157-1711-408d-a016-976ff5459b30" name="consume-failedRecords-sub-flow"/>
			</batch:on-complete>
		</batch:job>
		<logger level="INFO" doc:name="Log End INFO" doc:id="41ed6aa5-975f-4296-990b-ebf1ec5c39d3" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "INFO",&#10;    "flowName": "inventory-papi-batch-job-sub-flow",&#10;    "step": "END",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": "Segregation of valid and invalid records in the file " ++ (vars.orgFileName default "") ++ " completed"&#10;}]' />
		<logger level="DEBUG" doc:name="Log End DEBUG" doc:id="0778ec2d-da4f-45c6-a9ac-8c0cbc9e78b2" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    "logType": "DEBUG",&#10;    "flowName": "inventory-papi-batch-job-sub-flow",&#10;    "step": "END",&#10;    "dateTime": now() as String {format: "yyyy-MM-dd HH:mm:ss.SSS"},&#10;    "correlationId": vars.correlationId default uuid(),&#10;    "message": "Segregation of valid and invalid records in the file " ++ (vars.orgFileName default "") ++ " ended",&#10;    "payload": write(vars.filePayload, "application/json")&#10;}]' category="${debug.category}" />
	
</sub-flow>
	</mule>
